Hypoxia_vs_Control_sig$gene_id   <- unique(as.character(Hypoxia_vs_Control_sig$gene_id))
Normoxia_vs_Hypoxia_sig$gene_id  <- unique(as.character(Normoxia_vs_Hypoxia_sig$gene_id))
