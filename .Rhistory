merged <- merged %>%
mutate(observed_direction = ifelse(log2FoldChange > 0, "Up", "Down"))
View(merged)
# Filter significant genes (adjust p-value threshold if needed)
sig <- merged %>%
filter(padj < 0.05)
# Compare observed vs expected hypoxia response
comparison <- sig %>%
select(gene_id, gene_name, log2FoldChange, padj, expected_response, observed_direction)
# Find genes where observed matches expected
match <- sig %>%
filter(
(observed_direction == "Up" & grepl("increase|induction", expected_response, ignore.case = TRUE)) |
(observed_direction == "Down" & grepl("decrease|repression", expected_response, ignore.case = TRUE))
)
# Output results
print(head(comparison))
cat("Number of overlapping significant genes:", nrow(sig), "\n")
cat("Number of genes matching expected response:", nrow(match), "\n")
