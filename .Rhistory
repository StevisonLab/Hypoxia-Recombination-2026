Hypoxia_vs_Normoxia_Day2_deg <- read.csv("Hypoxia_Day2vsNormoxia_Day2_deg.csv", row.names = 1)
Control_vs_Normoxia_Day2_deg <- read.csv("Control_Day2vsNormoxia_Day2_deg.csv", row.names = 1)
Control_vs_Hypoxia_Day2_deg  <- read.csv("Control_Day2vsHypoxia_Day2_deg.csv",  row.names = 1)
# Day 6
Hypoxia_vs_Normoxia_Day6_deg <- read.csv("Hypoxia_Day6vsNormoxia_Day6_deg.csv", row.names = 1)
Control_vs_Normoxia_Day6_deg <- read.csv("Control_Day6vsNormoxia_Day6_deg.csv", row.names = 1)
Control_vs_Hypoxia_Day6_deg  <- read.csv("Control_Day6vsHypoxia_Day6_deg.csv",  row.names = 1)
# --------------------------
# FLIP log2FoldChange so Control is always on the left
# --------------------------
Control_vs_Hypoxia_Day2_deg  <- Control_vs_Hypoxia_Day2_deg  %>% mutate(log2FoldChange = -log2FoldChange)
Control_vs_Normoxia_Day2_deg <- Control_vs_Normoxia_Day2_deg %>% mutate(log2FoldChange = -log2FoldChange)
Control_vs_Hypoxia_Day6_deg  <- Control_vs_Hypoxia_Day6_deg  %>% mutate(log2FoldChange = -log2FoldChange)
Control_vs_Normoxia_Day6_deg <- Control_vs_Normoxia_Day6_deg %>% mutate(log2FoldChange = -log2FoldChange)
# Flip so Chamber 21% is on the right vs Chamber 8% on the left
Hypoxia_vs_Normoxia_Day2_deg <- Hypoxia_vs_Normoxia_Day2_deg %>% mutate(log2FoldChange = -log2FoldChange)
Hypoxia_vs_Normoxia_Day6_deg <- Hypoxia_vs_Normoxia_Day6_deg %>% mutate(log2FoldChange = -log2FoldChange)
# --------------------------
# Legend setup
# --------------------------
legend_colors <- c(
"#c51b7d",
"#01665e",
"#bf812d",
"gray70"
)
names(legend_colors) <- c(
paste0("Upregulated in ", cond_hypoxia),
paste0("Upregulated in ", cond_normoxia),
paste0("Upregulated in ", cond_control),
"Not significant"
)
# --------------------------
# Global x-limits AND y-limits across ALL 6 datasets
# --------------------------
all_log2FC <- c(
Hypoxia_vs_Normoxia_Day2_deg$log2FoldChange,
Control_vs_Normoxia_Day2_deg$log2FoldChange,
Control_vs_Hypoxia_Day2_deg$log2FoldChange,
Hypoxia_vs_Normoxia_Day6_deg$log2FoldChange,
Control_vs_Normoxia_Day6_deg$log2FoldChange,
Control_vs_Hypoxia_Day6_deg$log2FoldChange
)
all_neglog10p <- c(
-log10(Hypoxia_vs_Normoxia_Day2_deg$padj),
-log10(Control_vs_Normoxia_Day2_deg$padj),
-log10(Control_vs_Hypoxia_Day2_deg$padj),
-log10(Hypoxia_vs_Normoxia_Day6_deg$padj),
-log10(Control_vs_Normoxia_Day6_deg$padj),
-log10(Control_vs_Hypoxia_Day6_deg$padj)
)
# Symmetric x-axis around 0 for clean look
x_max    <- ceiling(max(abs(all_log2FC), na.rm = TRUE))
x_limits <- c(-x_max, x_max)
y_limits <- c(0, max(all_neglog10p, na.rm = TRUE) * 1.1)
# --------------------------
# Volcano plot function
# --------------------------
create_volcano_plot <- function(deg_data, title, condition_right, condition_left,
pval_threshold = 0.05, top_genes = 20,
ylim = NULL, xlim = NULL) {
# Split top genes per side
n_each <- ceiling(top_genes / 2)  # 10 per side if top_genes = 20
deg_data <- deg_data %>%
mutate(
log2FC = log2FoldChange,
neglog10p = -log10(padj),
significance = case_when(
log2FC > 0 & padj < pval_threshold ~ paste0("Upregulated in ", condition_right),
log2FC < 0 & padj < pval_threshold ~ paste0("Upregulated in ", condition_left),
TRUE ~ "Not significant"
)
)
deg_data$significance <- factor(deg_data$significance, levels = names(legend_colors))
deg_data <- deg_data %>% filter(!is.na(log2FC) & !is.na(neglog10p) & !is.infinite(neglog10p))
# Top genes per side
genes_right <- deg_data %>%
filter(significance == paste0("Upregulated in ", condition_right)) %>%
arrange(padj, desc(abs(log2FC))) %>%
head(n_each)
genes_left <- deg_data %>%
filter(significance == paste0("Upregulated in ", condition_left)) %>%
arrange(padj, desc(abs(log2FC))) %>%
head(n_each)
genes_to_label <- bind_rows(genes_right, genes_left)
p <- ggplot(deg_data, aes(x = log2FC, y = neglog10p)) +
geom_point(aes(color = significance), alpha = 0.6, size = 4.5) +
scale_color_manual(values = legend_colors, limits = names(legend_colors), drop = FALSE) +
geom_hline(yintercept = -log10(pval_threshold), linetype = "dashed", color = "gray40") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray40") +
geom_text_repel(
data = genes_to_label,
aes(label = gene_name),
size = 5,
box.padding = 0.3,
point.padding = 0.2,
segment.color = "gray50",
segment.size = 0.4,
min.segment.length = 0.05,
force = 1.5,
max.overlaps = Inf
) +
labs(
title = title,
x = "Log2 Fold Change",
y = "-Log10 Adjusted P-value",
color = "Legend"
) +
theme_classic() +
theme(
plot.title = element_text(hjust = 0.5, face = "bold", size = 16),
legend.title = element_text(size = 18, face = "bold"),
legend.text = element_text(size = 13, face = "bold"),
legend.key.size = unit(1.5, "cm"),
axis.text = element_text(size = 13),
axis.title = element_text(size = 15, face = "bold")
)
if (!is.null(ylim) | !is.null(xlim)) {
p <- p + coord_cartesian(ylim = ylim, xlim = xlim)
}
return(p)
}
# --------------------------
# Shared legend via dummy plot
# --------------------------
dummy <- ggplot(
data.frame(
x     = 1:4,
y     = 1:4,
label = factor(names(legend_colors), levels = names(legend_colors))
),
aes(x = x, y = y, color = label)
) +
geom_point(size = 6) +
scale_color_manual(values = legend_colors, drop = FALSE) +
guides(color = guide_legend(title = "Legend", override.aes = list(size = 6))) +
theme_void() +
theme(
legend.position = "right",
legend.title    = element_text(size = 18, face = "bold"),
legend.text     = element_text(size = 13, face = "bold"),
legend.key.size = unit(1.5, "cm")
)
leg <- get_legend(dummy)
stopifnot(!inherits(leg, "zeroGrob"))
# ==========================
# DAY 2 PLOTS
# ==========================
