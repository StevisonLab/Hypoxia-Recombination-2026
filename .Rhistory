geom_hline(yintercept = -log10(pval_threshold), linetype = "dashed", color = "gray40") +
geom_vline(xintercept = 0, linetype = "dashed", color = "gray40") +
geom_text_repel(
data = genes_to_label,
aes(label = gene_name),
size = 5,
